# The build context is 227 MB without this, most of it host-only tooling.
.git
.github
.claude
.idea

# Local runtime state — the image creates its own empty dirs for these.
tmp/
dbs/
uploads/

# Host-native Tailwind CLI (76 MB, macOS binary) and plugins: the image downloads
# its own Linux build via `make tailwind-install`. Host JS deps and bundle output
# are rebuilt in the image too.
tailwindcss
daisyui.js
daisyui-theme.js
node_modules
public/static/js/

# Not read by `go build`.
docs/
tasks/
scripts/
README.md
PAGODA.md
LICENSE
.air.toml
sqlc.yaml
docker-compose.yml
Dockerfile
.dockerignore
